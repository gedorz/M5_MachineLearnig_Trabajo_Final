# Datos básicos para que los contenedores de Docker funcionen correctamente, como la zona horaria y las variables de entorno para la base de datos de Postgres.
# sincronizando las fechas y posicion geográfica de los contenedores 
# con la zona horaria de Madrid, España.
TZ=Europe/Madrid
GENERIC_TIMEZONE=Europe/Madrid

# variables de entorno para la base de datos de Postgres
POSTGRES_USER=taskmanageruser
POSTGRES_PASSWORD=Qazwsx12
POSTGRES_DB=dbtaskmanager
POSTGRES_NON_ROOT_USER=${POSTGRES_USER}
POSTGRES_NON_ROOT_PASSWORD=${POSTGRES_PASSWORD}

# Asignación de variables de conexión a la base de datos de Postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_NON_ROOT_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_NON_ROOT_PASSWORD}

# Ruta de archivos local para inicializar la base de datos de Postgres con la tabla 
# los usuarios y la tabla de tareas. 
LOCAL_FILES_SCRIPT=./init-scripts